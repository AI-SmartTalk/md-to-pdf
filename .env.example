# Copier en .env à côté de docker-compose.prod.yml, puis remplir.
# install.sh génère ce fichier et une API_KEY aléatoire s'il est absent.

# Obligatoire. Ferme /api/* : les clients envoient X-API-Key ou
# Authorization: Bearer. Générer avec : openssl rand -hex 32
# Attention : l'endpoint historique POST / (multipart/form-data) reste ouvert
# par conception, pour la rétro-compatibilité des intégrations existantes.
#
# Deux écritures sont acceptées :
#   API_KEY=s3cr3t                          une clé unique, anonyme (historique)
#   API_KEY=core=s3cr3t,zapier=t0k3n        une clé nommée par intégration
# La forme nommée est ce qui permet d'attribuer la consommation : le nom part
# dans les logs (champ api_key), dans la métrique mdtopdf_requests_by_key_total
# et dans le compteur de quota. Une valeur sans « = » n'est jamais découpée,
# même si elle contient une virgule.
API_KEY=

# Requêtes par minute et par clé. 0 (défaut) : aucun plafond, comportement
# historique. Au-delà, la réponse est un 429 avec Retry-After.
API_QUOTA_PER_MINUTE=0

# Palier gratuit. À false (défaut), rien ne change : un déploiement qui a posé
# une API_KEY reste aussi fermé qu'avant. À true, les endpoints que pilotent les
# pages publiques (/outils, /tools) acceptent une requête SANS clé, comptée par
# adresse cliente. Une clé valide l'emporte toujours et garde son propre quota ;
# une clé présentée mais fausse reste une erreur, sans repli sur le palier
# gratuit — sinon une faute de frappe dans un déploiement passerait inaperçue.
# /api/render et /api/metrics ne sont jamais ouverts : un moteur de gabarits face
# à l'Internet ouvert est une autre conversation.
PUBLIC_TOOLS=false
PUBLIC_QUOTA_PER_MINUTE=20

# Base publique annoncée par /sitemap.xml et /robots.txt.
PUBLIC_BASE_URL=https://pdf.aismarttalk.tech

# ---------------------------------------------------------------------------
# Fichiers déposés (POST /api/files)
# ---------------------------------------------------------------------------

# Durée de vie d'un fichier uploadé, en secondes. C'est la promesse de
# rétention : un fichier déposé par un utilisateur est une donnée personnelle,
# et le seul engagement qui ne surprend personne est celui que le service tient
# tout seul. 7200 = 2 h. L'expiration est appliquée à la lecture ET par balayage.
ASSET_TTL_SECS=7200

# La même chose pour le travail qui appartient à un compte. Plus long, parce que
# c'est ce que la page d'inscription offre en échange d'une adresse : une promesse
# affichée doit être un nombre dans le code. 86400 = 24 h. Les fichiers d'un
# visiteur anonyme restent régis par ASSET_TTL_SECS ci-dessus.
ASSET_TTL_MEMBER_SECS=86400

# Tentatives de connexion ou d'inscription par minute et par adresse cliente.
# Deux choses à la fois : la limite anti-force-brute (un mauvais mot de passe ne
# produit ni verrouillage ni délai au-delà du hachage), et la limite anti-déni de
# service (chaque tentative coûte 600 000 tours de PBKDF2 sur un pool borné, donc
# quelques clients en boucle rendraient la connexion impossible pour tout le monde).
# Compté par adresse et non par compte : compter par compte permettrait de verrouiller
# quelqu'un hors de son propre compte en échouant à sa place. 0 = aucune limite.
AUTH_ATTEMPTS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Bac à sable des convertisseurs
# ---------------------------------------------------------------------------

# Chemin du spool partagé entre l'API et le worker.
#
# Défini, l'API n'exécute plus aucun convertisseur elle-même : elle demande au
# service md-to-pdf-worker de le faire, et ce conteneur n'a AUCUNE interface
# réseau (network_mode: none dans docker-compose.prod.yml). Ghostscript,
# LibreOffice, Tesseract, pandoc, WeasyPrint, poppler, qpdf et img2pdf reçoivent
# des octets choisis par un inconnu dès que PUBLIC_TOOLS est allumé ; leur retirer
# le réseau est ce qui empêche un parseur retourné d'emporter quoi que ce soit.
#
# Vide, tout s'exécute dans le conteneur de l'API, comme avant l'existence du
# worker. C'est ce que fait le développement, et c'est sans risque tant que le
# service n'ingère rien d'inconnu.
#
# docker-compose.prod.yml le définit déjà : il n'y a rien à faire ici sauf pour
# le désactiver volontairement.
SANDBOX_SPOOL=/home/rocket/spool

# Plafonds d'entrée. Ils doivent rester cohérents avec les limites Rocket de
# Rocket.toml (data-form / file) : un fichier refusé par le framework produit
# une erreur bien moins claire que celle de l'endpoint.
ASSET_MAX_MB=100
ASSET_MAX_PAGES=2000

# Durée de conservation d'un travail asynchrone terminé, en secondes.
# Passé ce délai, GET /api/jobs/{id} répond 404 : le résultat a été récupéré,
# ou il ne le sera jamais.
JOB_TTL_SECS=3600

# Clé de signature des attestations de rendu et des callbacks de travaux.
# Non renseignée, une clé est tirée au démarrage : les attestations restent
# vérifiables tant que le processus vit, et cessent de l'être après un
# redémarrage. C'est le comportement honnête (une attestation invérifiable vaut
# mieux qu'une attestation falsifiable), mais en production il faut la fixer.
# Générer avec : openssl rand -hex 32
ATTESTATION_SECRET=

# Limite de temps, en secondes, accordée à pandoc / weasyprint / qpdf / pdftoppm.
# Au-delà, le processus est tué et le client reçoit un 504.
PDF_PROCESS_TIMEOUT_SECS=60

# Limite de temps, en secondes, accordée à un TRAVAIL COMPLET (rendu, aperçu,
# caviardage, comparaison) : tous ses processus et toutes ses passes réunis. Les
# limites par processus ne s'additionnent pas ; sans ce plafond, une requête peut
# survivre au timeout du proxy en gardant sa place dans la file. À garder sous
# ProxyTimeout - PDF_QUEUE_TIMEOUT_SECS (180 - 30 = 150 avec deploy/).
PDF_RENDER_DEADLINE_SECS=120

# Niveau de log du service (error, warn, info, debug, trace).
RUST_LOG=info

# Garde-fous de ressources du conteneur.
MEM_LIMIT=1g
CPUS=2.0

# Purge des PDFs sauvegardés, en jours (voir deploy/pdf-purge.sh).
# Les download_url distribués aux utilisateurs cessent de répondre au-delà.
PDF_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Rendu : file d'attente et cache
# ---------------------------------------------------------------------------

# Nombre de rendus simultanés. Par défaut : le nombre de cœurs, borné à 8 ;
# une valeur explicite est plafonnée à 64. Au-delà d'une poignée de weasyprint
# en parallèle le conteneur atteint sa limite mémoire avant d'aller plus vite.
PDF_MAX_CONCURRENCY=

# Attente maximale dans la file avant de renvoyer un 429, en secondes.
PDF_QUEUE_TIMEOUT_SECS=30

# Cache de rendu adressé par contenu (public/cache). Actif par défaut ; il n'a
# ni endpoint de purge ni invalidation manuelle, seuls le TTL, l'éviction LRU
# et la version interne du cache font le ménage.
PDF_CACHE_ENABLED=true
PDF_CACHE_MAX_MB=512
PDF_CACHE_TTL_SECS=604800

# Nombre de passes correctives du Layout Doctor (options.autolayout), 0 à 3.
PDF_LAYOUT_MAX_PASSES=1

# Plafond de pages rendues par /api/preview. /api/diff n'est PAS concerné : il
# compare au plus 200 pages, valeur codée en dur dans src/routes/diff.rs.
PDF_PREVIEW_MAX_PAGES=20

# ---------------------------------------------------------------------------
# Anti-SSRF : ce que le moteur de rendu a le droit d'aller chercher
# ---------------------------------------------------------------------------

# Hôtes autorisés pour les ressources distantes (images, @import, url()),
# séparés par des virgules. VIDE = tout hôte public est joignable ; les
# adresses privées, la boucle locale et les endpoints de métadonnées restent
# refusés dans tous les cas.
PDF_ALLOWED_URL_HOSTS=

# true : une liste vide veut dire « aucun hôte », donc plus aucune ressource
# distante. À activer sur un déploiement qui n'embarque que des assets locaux.
PDF_URL_STRICT_HOSTS=false

# false : refuse aussi les fichiers locaux (file://, chemins relatifs). Un
# document qui en référence rend sans la ressource, il n'échoue pas.
PDF_ALLOW_LOCAL_ASSETS=true

# Moteurs que POST / (sans clé) a le droit de choisir, séparés par des virgules.
# Seul weasyprint rend derrière le récupérateur gardé de weasyprint-safe.py :
# wkhtmltopdf suit les redirections HTTP lui-même et pdflatex ouvre des fichiers
# locaux lui-même, or l'analyse d'URL ne voit que le document tel qu'il a été
# posté. Les deux restent disponibles sur /api/convert, avec clé.
# VIDE = weasyprint seul.
PDF_UNAUTHENTICATED_ENGINES=

# Garde-fous du récupérateur de ressources (enveloppe weasyprint-safe.py).
PDF_URLGUARD_TIMEOUT_SECS=10
PDF_URLGUARD_MAX_BYTES=10485760
PDF_URLGUARD_MAX_REDIRECTS=3
# Chemins supplémentaires lisibles en file://, séparés par « : ». Le service
# renseigne déjà sa feuille de style temporaire.
PDF_URLGUARD_ALLOW_FILES=
# Fichier où journaliser les refus, en plus de stderr.
PDF_URLGUARD_LOG=
# Trappe de secours : PDF_URL_GUARD=off désactive entièrement l'enveloppe.
# À n'utiliser que pour diagnostiquer, jamais en régime permanent.
PDF_URL_GUARD=

# ---------------------------------------------------------------------------
# Diagrammes Mermaid
# ---------------------------------------------------------------------------

# Le conteneur doit pouvoir joindre ce service en sortie. Une valeur
# explicitement VIDE désactive proprement les blocs ```mermaid : le document
# sort quand même, le diagramme reste un bloc de code et un avertissement
# apparaît dans le champ "warnings" de la réponse.
MERMAID_API_URL=https://mermaid.aismarttalk.tech/api/v1
MERMAID_API_KEY=
MERMAID_TIMEOUT_SECS=15

# ---------------------------------------------------------------------------
# Observabilité
# ---------------------------------------------------------------------------

# Sans LOG420_INGEST_TOKEN rien n'est expédié : l'observabilité reste locale
# (logs du conteneur et GET /api/metrics).
LOG420_URL=https://log420.aist-core.fr
LOG420_INGEST_TOKEN=
LOG420_REGION=eu
SERVICE_NAME=md-to-pdf
