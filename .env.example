# Copier en .env à côté de docker-compose.prod.yml, puis remplir.
# install.sh génère ce fichier et une API_KEY aléatoire s'il est absent.

# Obligatoire. Ferme /api/* : les clients envoient X-API-Key ou
# Authorization: Bearer. Générer avec : openssl rand -hex 32
# Attention : l'endpoint historique POST / (multipart/form-data) reste ouvert
# par conception, pour la rétro-compatibilité des intégrations existantes.
API_KEY=

# Limite de temps, en secondes, accordée à pandoc / weasyprint / qpdf / pdftoppm.
# Au-delà, le processus est tué et le client reçoit un 504.
PDF_PROCESS_TIMEOUT_SECS=60

# Limite de temps, en secondes, accordée à un TRAVAIL COMPLET (rendu, aperçu,
# caviardage, comparaison) : tous ses processus et toutes ses passes réunis. Les
# limites par processus ne s'additionnent pas ; sans ce plafond, une requête peut
# survivre au timeout du proxy en gardant sa place dans la file. À garder sous
# ProxyTimeout - PDF_QUEUE_TIMEOUT_SECS (180 - 30 = 150 avec deploy/).
PDF_RENDER_DEADLINE_SECS=120

# Niveau de log du service (error, warn, info, debug, trace).
RUST_LOG=info

# Garde-fous de ressources du conteneur.
MEM_LIMIT=1g
CPUS=2.0

# Purge des PDFs sauvegardés, en jours (voir deploy/pdf-purge.sh).
# Les download_url distribués aux utilisateurs cessent de répondre au-delà.
PDF_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Rendu : file d'attente et cache
# ---------------------------------------------------------------------------

# Nombre de rendus simultanés. Par défaut : le nombre de cœurs, borné à 8 ;
# une valeur explicite est plafonnée à 64. Au-delà d'une poignée de weasyprint
# en parallèle le conteneur atteint sa limite mémoire avant d'aller plus vite.
PDF_MAX_CONCURRENCY=

# Attente maximale dans la file avant de renvoyer un 429, en secondes.
PDF_QUEUE_TIMEOUT_SECS=30

# Cache de rendu adressé par contenu (public/cache). Actif par défaut ; il n'a
# ni endpoint de purge ni invalidation manuelle, seuls le TTL, l'éviction LRU
# et la version interne du cache font le ménage.
PDF_CACHE_ENABLED=true
PDF_CACHE_MAX_MB=512
PDF_CACHE_TTL_SECS=604800

# Nombre de passes correctives du Layout Doctor (options.autolayout), 0 à 3.
PDF_LAYOUT_MAX_PASSES=1

# Plafond de pages rendues par /api/preview. /api/diff n'est PAS concerné : il
# compare au plus 200 pages, valeur codée en dur dans src/routes/diff.rs.
PDF_PREVIEW_MAX_PAGES=20

# ---------------------------------------------------------------------------
# Anti-SSRF : ce que le moteur de rendu a le droit d'aller chercher
# ---------------------------------------------------------------------------

# Hôtes autorisés pour les ressources distantes (images, @import, url()),
# séparés par des virgules. VIDE = tout hôte public est joignable ; les
# adresses privées, la boucle locale et les endpoints de métadonnées restent
# refusés dans tous les cas.
PDF_ALLOWED_URL_HOSTS=

# true : une liste vide veut dire « aucun hôte », donc plus aucune ressource
# distante. À activer sur un déploiement qui n'embarque que des assets locaux.
PDF_URL_STRICT_HOSTS=false

# false : refuse aussi les fichiers locaux (file://, chemins relatifs). Un
# document qui en référence rend sans la ressource, il n'échoue pas.
PDF_ALLOW_LOCAL_ASSETS=true

# Moteurs que POST / (sans clé) a le droit de choisir, séparés par des virgules.
# Seul weasyprint rend derrière le récupérateur gardé de weasyprint-safe.py :
# wkhtmltopdf suit les redirections HTTP lui-même et pdflatex ouvre des fichiers
# locaux lui-même, or l'analyse d'URL ne voit que le document tel qu'il a été
# posté. Les deux restent disponibles sur /api/convert, avec clé.
# VIDE = weasyprint seul.
PDF_UNAUTHENTICATED_ENGINES=

# Garde-fous du récupérateur de ressources (enveloppe weasyprint-safe.py).
PDF_URLGUARD_TIMEOUT_SECS=10
PDF_URLGUARD_MAX_BYTES=10485760
PDF_URLGUARD_MAX_REDIRECTS=3
# Chemins supplémentaires lisibles en file://, séparés par « : ». Le service
# renseigne déjà sa feuille de style temporaire.
PDF_URLGUARD_ALLOW_FILES=
# Fichier où journaliser les refus, en plus de stderr.
PDF_URLGUARD_LOG=
# Trappe de secours : PDF_URL_GUARD=off désactive entièrement l'enveloppe.
# À n'utiliser que pour diagnostiquer, jamais en régime permanent.
PDF_URL_GUARD=

# ---------------------------------------------------------------------------
# Diagrammes Mermaid
# ---------------------------------------------------------------------------

# Le conteneur doit pouvoir joindre ce service en sortie. Une valeur
# explicitement VIDE désactive proprement les blocs ```mermaid : le document
# sort quand même, le diagramme reste un bloc de code et un avertissement
# apparaît dans le champ "warnings" de la réponse.
MERMAID_API_URL=https://mermaid.aismarttalk.tech/api/v1
MERMAID_API_KEY=
MERMAID_TIMEOUT_SECS=15

# ---------------------------------------------------------------------------
# Observabilité
# ---------------------------------------------------------------------------

# Sans LOG420_INGEST_TOKEN rien n'est expédié : l'observabilité reste locale
# (logs du conteneur et GET /api/metrics).
LOG420_URL=https://log420.aist-core.fr
LOG420_INGEST_TOKEN=
LOG420_REGION=eu
SERVICE_NAME=md-to-pdf
