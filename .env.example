# Copier en .env à côté de docker-compose.prod.yml, puis remplir.
# install.sh génère ce fichier et une API_KEY aléatoire s'il est absent.

# Obligatoire. Ferme /api/* : les clients envoient X-API-Key ou
# Authorization: Bearer. Générer avec : openssl rand -hex 32
# Attention : l'endpoint historique POST / (multipart/form-data) reste ouvert
# par conception, pour la rétro-compatibilité des intégrations existantes.
API_KEY=

# Limite de temps, en secondes, accordée à pandoc / weasyprint / qpdf / pdftoppm.
# Au-delà, le processus est tué et le client reçoit un 504.
PDF_PROCESS_TIMEOUT_SECS=60

# Niveau de log du service (error, warn, info, debug, trace).
RUST_LOG=info

# Garde-fous de ressources du conteneur.
MEM_LIMIT=1g
CPUS=2.0

# Purge des PDFs sauvegardés, en jours (voir deploy/pdf-purge.sh).
# Les download_url distribués aux utilisateurs cessent de répondre au-delà.
PDF_RETENTION_DAYS=180
